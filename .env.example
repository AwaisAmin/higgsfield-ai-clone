# ---------------------------------------------------------------------------
# Clerk — https://dashboard.clerk.com → your app → API keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Keep Clerk's redirects pointed at our own themed pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ---------------------------------------------------------------------------
# Neon Postgres — https://console.neon.tech → your project → Connection string
#
# Two URLs, on purpose:
#   DATABASE_URL  pooled   (host contains "-pooler") — used at request time
#   DIRECT_URL    direct   (no "-pooler")            — used by prisma migrate,
#                                                      which needs advisory
#                                                      locks PgBouncer lacks
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
